SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Recommended for Vercel/serverless: Supabase Transaction Pooler.
# URL-encode special password characters: # -> %23, @ -> %40
SUPABASE_DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_EMPLOYEE_EMAIL_DOMAIN=aurum.local
POSTGRES_POOL_MAX=10
PGSSLMODE=require
SEED_ADMIN_EMPLOYEE_ID=AD001
SEED_ADMIN_NAME=Owner Admin
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=replace-with-strong-password
